# ----------------------------
# Next.js app (Vercel) - browser-safe
# ----------------------------
# Optional. Used by app/page.tsx as default API base URL in the composer.
NEXT_PUBLIC_APP_BASE_URL=https://your-vercel-app.vercel.app

# ----------------------------
# Next.js app (Vercel) - server-only secrets
# ----------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional tenant mapping fallback for webhook routes.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Disabled by default. Set to true only for local/dev setup flows (never in production).
# HUBCHAT_ALLOW_SETUP_SUPABASE_TOKEN=true

# Channel webhook / outbound adapter configuration (server-only)
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
FACEBOOK_VERIFY_TOKEN=your-facebook-verify-token
# Required for Meta webhook POST signature verification (Facebook + Instagram inbound).
FACEBOOK_APP_SECRET=your-meta-app-secret
# META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v25.0
INSTAGRAM_VERIFY_TOKEN=your-instagram-verify-token
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
# INSTAGRAM_PAGE_ID=your-connected-facebook-page-id
# INSTAGRAM_ACCOUNT_ID=legacy-instagram-business-account-id
# INSTAGRAM_APP_SECRET=legacy-alias-for-meta-app-secret

# Outbound image upload + provider URL strategy (server-only)
# MESSAGE_IMAGE_BUCKET=message-images
# MESSAGE_IMAGE_URL_MODE=signed
# MESSAGE_IMAGE_SIGNED_URL_TTL_SEC=2592000

# Inbound image media strategy (server-only; worker uses these)
# INBOUND_MEDIA_BUCKET=inbound-media
# INBOUND_MEDIA_URL_MODE=public
# INBOUND_MEDIA_MAX_SIZE_MB=10

# Profile avatar cache (worker only; event-driven after inbound profile URL updates)
# HUBCHAT_PROFILE_AVATAR_CACHE_ENABLED=false
# HUBCHAT_PROFILE_AVATAR_BUCKET=profile-avatars
# HUBCHAT_PROFILE_AVATAR_MAX_BYTES=524288
# HUBCHAT_PROFILE_AVATAR_FETCH_TIMEOUT_MS=10000

# ----------------------------
# Worker (Railway) variables are configured separately.
# See env/worker.low.env.template, env/worker.medium.env.template, env/worker.high.env.template
# ----------------------------

# ----------------------------
# Playwright E2E (tests/e2e) — set in shell or CI secrets; never commit real passwords.
# Prefer a staging deployment URL. Production-like hosts require E2E_ALLOW_PRODUCTION=true.
# ----------------------------
# E2E_BASE_URL=https://your-staging-app.vercel.app
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_MANAGER_EMAIL=
# E2E_MANAGER_PASSWORD=
# E2E_SALES_EMAIL=
# E2E_SALES_PASSWORD=
# E2E_TEST_EMAIL_DOMAIN=example.com
# E2E_NEW_USER_PASSWORD=
# E2E_ALLOW_PRODUCTION=
