{
  "name": "hub-chat-omnichannel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build:web": "next build",
    "start": "next start",
    "lint": "next typegen && npx tsc -p tsconfig.json --noEmit",
    "build": "next build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "loadtest": "node --import tsx scripts/loadtest-harness.mjs",
    "validate:summary": "node --import tsx scripts/validation-summary.mjs",
    "validate:stage": "node --import tsx scripts/run-validation-stage.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "dev:worker": "tsx src/worker/main.ts",
    "start:worker": "tsx src/worker/main.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "next": "^16.2.2",
    "pino": "^9.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
